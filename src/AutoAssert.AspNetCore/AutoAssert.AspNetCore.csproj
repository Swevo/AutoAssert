<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackageId>Swevo.AutoAssert.AspNetCore</PackageId>
    <Version>1.0.0</Version>
    <Authors>Justin Bannister</Authors>
    <Copyright>Copyright (c) 2026 Justin Bannister</Copyright>
    <Description>HTTP response assertions for AutoAssert: fluent, chainable assertions for HttpResponseMessage (status codes, headers, content type, string/JSON body) — ideal for ASP.NET Core WebApplicationFactory/TestServer integration tests and HttpClient-based API tests.</Description>
    <PackageTags>testing;assertions;http;aspnetcore;webapplicationfactory;fluent-assertions;dotnet;csharp;free;mit</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Swevo/AutoAssert</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Swevo/AutoAssert</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoAssert\AutoAssert.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.*" />
  </ItemGroup>

</Project>
